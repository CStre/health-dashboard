# OS
.DS_Store

# Editor
.vscode/
.idea/

# Node (if converter tooling grows deps)
node_modules/

# Raw source spreadsheets — keep the original Excel out of git by default;
# the generated data/*.js files are the committed representation.
raw/
*.xlsx
*.xls

# Local plaintext sources — never committed; encrypted into data/health.enc.json by scripts/build.js
source/
data/health.local.enc.json
# Plaintext payload for design iteration (npm run build:dev) — real data, unencrypted
data/health.dev.json

# Self-contained local preview build (npm run build:local) — contains real data
local.html
